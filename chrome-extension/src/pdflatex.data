% Hooks in both directions

\pgfarrowsdeclare{hooks}{hooks}
{
  \pgfutil@tempdima=0.4pt%
  \advance\pgfutil@tempdima by.2\pgflinewidth%
  \pgfarrowsleftextend{+-.5\pgflinewidth}
